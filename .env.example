# ---- 数据库配置 ----
# 复制本文件为 .env 后按需修改，或直接用 shell 环境变量注入
DB_USER=root
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=3306
DB_NAME=news_app
DB_CHARSET=utf8mb4
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Docker Compose 用的 MySQL root 密码。
# 留空则 compose 回落到 root123456（仅本地开发用，切勿在生产沿用）
COMPOSE_MYSQL_ROOT_PASSWORD=

# ---- AI 检索配置 ----
# 每路召回条数，取并集后经 RRF 融合
AI_TOP_K_BM25=20
AI_TOP_K_VECTOR=20
# 喂给 LLM 的新闻条数
AI_TOP_K_FINAL=5
# RRF 平滑常数（原论文经验值 60）
AI_RRF_K=60
# 单路命中惩罚系数：两路都命中才不被降权
AI_SINGLE_PATH_WEIGHT=0.5
# 融合得分低于此值判定为「无相关报道」，直接拒答不调 LLM（防幻觉关键）
# 置信门控三级判据（见 ai/config.py 注释与 ai/eval/README.md 的标定过程）
#   向量余弦 0.55   —— 主判据，负例中位 0.48 / 正例中位 0.80
#   BM25 分数 40.0  —— 向量路不可用时的降级判据
#   RRF 融合分 0.02 —— 最后兜底（实测该判据无区分度，仅作保底）
AI_MIN_VECTOR_SIM=0.55
AI_MIN_BM25_SCORE=40.0
AI_MIN_FUSION_SCORE=0.02
# 每条新闻最多取多少字进上下文
AI_MAX_DOC_CHARS=400
# 语料索引与向量缓存时间（秒）
AI_INDEX_CACHE_TTL=3600
AI_EMBEDDING_CACHE_TTL=86400
# 检索链路追踪：默认只写结构化日志；
# 开启后额外按 request_id 把完整检索过程落到 Redis，便于事后回查
AI_TRACE_ENABLED=false
AI_TRACE_TTL=3600

# ---- AI 大模型配置 ----
# 密钥只放后端环境变量，绝不能出现在代码或前端浏览器里
DASHSCOPE_API_KEY=sk-your-key-here
DASHSCOPE_MODEL=deepseek-v4-flash-0731
DASHSCOPE_EMBED_MODEL=qwen3.7-text-embedding
# 向量维度。该模型支持 256/512/768/1024/1536/2048/2560，默认 1024。
# 改维度会让整套向量空间失效，离线索引会自动判定并全量重建。
DASHSCOPE_EMBED_DIM=1024

# ---------------- 成本闸门 ----------------
# 累计花费上限（元）。0 = 不限制。生产环境务必设置。
# 超额后 AI 接口返回 429，不再继续调用模型。
AI_BUDGET_TOTAL_CNY=1.0
# 单次问答花费上限（元），拦住异常长上下文
AI_BUDGET_ASK_CNY=0.05
# 达到预算该比例时打告警
AI_BUDGET_WARN_RATIO=0.8
