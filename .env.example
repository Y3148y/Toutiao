# ---- 数据库配置 ----
# 复制本文件为 .env 后按需修改，或直接用 shell 环境变量注入
DB_USER=root
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=3306
DB_NAME=news_app
DB_CHARSET=utf8mb4
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Docker Compose 用的 MySQL root 密码。
# 留空则 compose 回落到 root123456（仅本地开发用，切勿在生产沿用）
COMPOSE_MYSQL_ROOT_PASSWORD=

# ---- AI 检索配置 ----
# 每路召回条数，取并集后经 RRF 融合
AI_TOP_K_BM25=20
AI_TOP_K_VECTOR=20
# 喂给 LLM 的新闻条数
AI_TOP_K_FINAL=5
# RRF 平滑常数（原论文经验值 60）
AI_RRF_K=60
# 单路命中惩罚系数：两路都命中才不被降权
AI_SINGLE_PATH_WEIGHT=0.5
# 融合得分低于此值判定为「无相关报道」，直接拒答不调 LLM（防幻觉关键）
AI_MIN_FUSION_SCORE=0.02
# 每条新闻最多取多少字进上下文
AI_MAX_DOC_CHARS=400
# 语料索引与向量缓存时间（秒）
AI_INDEX_CACHE_TTL=3600
AI_EMBEDDING_CACHE_TTL=86400
# 检索链路追踪：默认只写结构化日志；
# 开启后额外按 request_id 把完整检索过程落到 Redis，便于事后回查
AI_TRACE_ENABLED=false
AI_TRACE_TTL=3600

# ---- AI 大模型配置 ----
# 密钥只放后端环境变量，绝不能出现在代码或前端浏览器里
DASHSCOPE_API_KEY=sk-your-key-here
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_EMBED_MODEL=text-embedding-v4
