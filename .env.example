# ---- 数据库配置 ----
# 复制本文件为 .env 后按需修改，或直接用 shell 环境变量注入
DB_USER=root
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=3306
DB_NAME=news_app
DB_CHARSET=utf8mb4
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Docker Compose 用的 MySQL root 密码。
# 留空则 compose 回落到 root123456（仅本地开发用，切勿在生产沿用）
COMPOSE_MYSQL_ROOT_PASSWORD=